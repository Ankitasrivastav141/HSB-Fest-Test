<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">

        <!-- Modal Header with Dark Gradient -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_modal_header"
            android:orientation="vertical"
            android:padding="18dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/dialog_close_btn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_button_slate"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="@color/slate_300"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/dialog_close_btn"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/dialog_event_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_pill_badge"
                        android:gravity="center"
                        android:text="⚡"
                        android:textSize="26sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/dialog_event_category"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_badge"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:text="Technical"
                                android:textColor="#A5B4FC"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/dialog_event_fee"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_alert_success"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:text="Free"
                                android:textColor="@color/emerald_700"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/dialog_event_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Event Title"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>

        <!-- Modal Body Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Quick Meta Details Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_seats"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DATE &amp; TIME"
                    android:textColor="@color/slate_400"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dialog_event_datetime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Nov 14, 10:00 AM"
                    android:textColor="@color/slate_700"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="6dp"
                    android:background="@color/slate_200" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VENUE"
                    android:textColor="@color/slate_400"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dialog_event_venue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Auditorium"
                    android:textColor="@color/slate_700"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="6dp"
                    android:background="@color/slate_200" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AVAILABILITY"
                    android:textColor="@color/slate_400"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dialog_event_seats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="30 / 100 seats remaining"
                    android:textColor="@color/emerald_600"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="DESCRIPTION"
                android:textColor="@color/slate_400"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dialog_event_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="Detailed event overview and rules."
                android:textColor="@color/slate_600"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="@color/slate_100" />

            <!-- Registration Form Heading -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Register for this Event"
                android:textColor="@color/slate_900"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Complete the form below to reserve your ticket. Registration is instant."
                android:textColor="@color/slate_500"
                android:textSize="11sp" />

            <!-- Error Alert inside form -->
            <LinearLayout
                android:id="@+id/dialog_form_error_alert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_alert_error"
                android:orientation="horizontal"
                android:padding="10dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ "
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/dialog_form_error_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Registration failed."
                    android:textColor="@color/red_700"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Success Alert inside form -->
            <LinearLayout
                android:id="@+id/dialog_form_success_alert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_alert_success"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎉 Registration Confirmed!"
                    android:textColor="@color/emerald_900"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dialog_form_success_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="You are registered for this event. See you at Zenith '26!"
                    android:textColor="@color/emerald_800"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Input: Student Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Student Full Name *"
                android:textColor="@color/slate_700"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input_reg_name"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_edittext"
                android:hint="e.g. Rahul Sharma"
                android:inputType="textPersonName"
                android:paddingHorizontal="12dp"
                android:textColor="@color/slate_800"
                android:textColorHint="@color/slate_400"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/error_reg_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Please enter your name."
                android:textColor="@color/red_600"
                android:textSize="10sp"
                android:visibility="gone" />

            <!-- Input: Roll Number -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Roll / Student ID *"
                android:textColor="@color/slate_700"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input_reg_roll"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_edittext"
                android:hint="e.g. 2026CS101"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="@color/slate_800"
                android:textColorHint="@color/slate_400"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/error_reg_roll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Please enter your roll number."
                android:textColor="@color/red_600"
                android:textSize="10sp"
                android:visibility="gone" />

            <!-- Input: Phone Number (optional) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Phone Number (optional)"
                android:textColor="@color/slate_700"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input_reg_phone"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_edittext"
                android:hint="e.g. 9876543210"
                android:inputType="phone"
                android:paddingHorizontal="12dp"
                android:textColor="@color/slate_800"
                android:textColorHint="@color/slate_400"
                android:textSize="12sp" />

            <!-- Input: Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="College / Personal Email *"
                android:textColor="@color/slate_700"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input_reg_email"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_edittext"
                android:hint="e.g. rahul@college.edu"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="12dp"
                android:textColor="@color/slate_800"
                android:textColorHint="@color/slate_400"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/error_reg_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Please enter a valid email address with '@'."
                android:textColor="@color/red_600"
                android:textSize="10sp"
                android:visibility="gone" />

            <!-- Action buttons: Cancel & Confirm Registration -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_cancel_registration"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:backgroundTint="@color/slate_100"
                    android:text="Cancel"
                    android:textAllCaps="false"
                    android:textColor="@color/slate_700"
                    android:textSize="12sp" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp">

                    <Button
                        android:id="@+id/btn_submit_registration"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:backgroundTint="@color/brand_600"
                        android:text="Confirm Registration"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progress_submitting_reg"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/white"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
