<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚙️ Backend Server Configuration"
        android:textColor="@color/slate_900"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:text="Configure the FastAPI backend URL. For Android Emulator use 10.0.2.2. For physical Android devices, enter your computer\'s local network IP."
        android:textColor="@color/slate_500"
        android:textSize="11sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Backend Base URL"
        android:textColor="@color/slate_700"
        android:textSize="11sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edit_server_url"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_edittext"
        android:hint="http://10.0.2.2:8002/"
        android:inputType="textUri"
        android:paddingHorizontal="12dp"
        android:textColor="@color/slate_800"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel_server_config"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="@color/slate_100"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/slate_700"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_save_server_config"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/brand_600"
            android:text="Save &amp; Reconnect"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
