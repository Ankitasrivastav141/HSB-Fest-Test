<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ZenithFest26" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_600</item>
        <item name="colorPrimaryVariant">@color/brand_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/brand_500</item>
        <item name="colorSecondaryVariant">@color/brand_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/slate_900</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Background -->
        <item name="android:windowBackground">@color/slate_50</item>
    </style>
</resources>
